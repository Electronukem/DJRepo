# Copy this file to .env and fill in the keys. .env stays on your machine (it's in .gitignore).

# The gig finder's events: a free key from https://developer.ticketmaster.com (Discovery API).
TICKETMASTER_API_KEY=

# The pitch emails: Meta's Muse Spark, through the Meta Model API. A key from https://dev.meta.ai
MODEL_API_KEY=

# Optional: a different Meta model or endpoint.
# META_MODEL=muse-spark-1.3
# META_API_BASE=https://api.meta.ai/v1
